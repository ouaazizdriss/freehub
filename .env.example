# Base de données (docker compose up -d)
DATABASE_URL="postgresql://freelancehub:freelancehub@localhost:5433/freelancehub?schema=public"

# Auth.js — générer avec : openssl rand -base64 33
AUTH_SECRET=""

# SSO Microsoft Entra ID (laisser vide en local tant que l'app n'est pas enregistrée dans le tenant)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Émetteur du tenant de l'entreprise (obligatoire si SSO). common / organizations / consumers sont refusés au
# démarrage : les comptes sont ensuite liés à leur identifiant Entra (oid), jamais à l'e-mail (protection nOAuth).
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# Connexion de démo sans mot de passe : "true" uniquement sur un poste de développement.
# Toujours inactive en production, si le SSO est configuré ou si APP_URL n'est pas locale.
AUTH_DEV_LOGIN="false"

# Derrière un reverse proxy TLS : URL publique et confiance dans les en-têtes X-Forwarded-*
# (cookies __Secure- et URL de rappel correctes).
# AUTH_URL="https://freelancehub.example.com"
# AUTH_TRUST_HOST="true"

# URL publique de l'application (liens des e-mails, URL de vérification imprimée sur les PDF)
APP_URL="http://localhost:3000"
# Secret du code d'authenticité des CRA (HMAC) — obligatoire en production, ≥ 32 caractères
# (openssl rand -base64 33). En dev, AUTH_SECRET est utilisé à défaut.
AUTH_CODE_SECRET=""
# E-mails : sans SMTP_URL, les messages sont seulement journalisés.
SMTP_URL=""
MAIL_FROM="Freelance Hub <no-reply@example.com>"
# Stockage privé des signatures et documents (dossier hors de public/)
STORAGE_DIR="storage"
# Secret du planificateur qui appelle POST /api/cron/reminders (≥ 32 caractères en production)
CRON_SECRET=""
