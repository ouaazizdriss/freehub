# Base de données (docker compose up -d)
DATABASE_URL="postgresql://freelancehub:freelancehub@localhost:5433/freelancehub?schema=public"

# Auth.js — générer avec : openssl rand -base64 33
AUTH_SECRET=""

# SSO Microsoft Entra ID (laisser vide en local tant que l'app n'est pas enregistrée dans le tenant)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# Connexion de démo sans SSO (jamais active en production, même si "true")
AUTH_DEV_LOGIN="true"

# URL publique de l'application (liens des e-mails, URL de vérification imprimée sur les PDF)
APP_URL="http://localhost:3000"
# Secret du code d'authenticité des CRA (HMAC) — obligatoire en production, ≥ 32 caractères
# (openssl rand -base64 33). En dev, AUTH_SECRET est utilisé à défaut.
AUTH_CODE_SECRET=""
# E-mails : sans SMTP_URL, les messages sont seulement journalisés.
SMTP_URL=""
MAIL_FROM="Freelance Hub <no-reply@example.com>"
# Stockage privé des signatures et documents (dossier hors de public/)
STORAGE_DIR="storage"
# Secret du planificateur qui appelle POST /api/cron/reminders (≥ 16 caractères)
CRON_SECRET=""
